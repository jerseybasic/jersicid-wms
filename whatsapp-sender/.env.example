# Kunci rahasia, harus sama dengan WA_SENDER_KEY di .env WMS. Buat yang panjang dan acak.
API_KEY=
# Alamat dan port. Biarkan 127.0.0.1 supaya hanya bisa diakses dari server ini.
HOST=127.0.0.1
PORT=3100
# Folder sesi WhatsApp Web (login tersimpan di sini, jangan dibagikan)
SESSION_DIR=./session
# true = tanpa jendela browser (untuk server). false = tampilkan browser (untuk mencoba di komputer sendiri)
HEADLESS=true
# Jeda antar pesan dalam milidetik, supaya tidak dianggap spam
DELAY_MS=4000
